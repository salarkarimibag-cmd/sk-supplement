# MongoDB Atlas connection string (from Atlas -> Connect -> Drivers).
MONGODB_URI=

# Database name inside the cluster. Leave unset in Production (defaults to
# "sk-supplement", the real store data). Set it to "sk-supplement-dev" here
# and in Vercel's Preview environment so testing never touches real data.
MONGODB_DB=sk-supplement-dev

# Secret used to sign login session cookies (JWT). Any long random string
# works for development; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ZarinPal merchant id (from your ZarinPal dashboard). Leave empty to see a
# clear "not configured" error instead of a silent failure.
ZARINPAL_MERCHANT_ID=

# "true" (default) hits https://sandbox.zarinpal.com — safe for testing, no
# real money moves and any merchant id format is accepted. Set to "false"
# once you have a real merchant id to go live.
ZARINPAL_SANDBOX=true

# The shop's bank card for card-to-card payment, shown to buyers at checkout.
# CARD_NUMBER must be 16 digits (spaces or dashes are fine). Leave
# CARD_NUMBER or CARD_HOLDER empty to hide the card-to-card option.
# CARD_BANK is optional.
CARD_NUMBER=
CARD_HOLDER=
CARD_BANK=

# Public site URL, used for SEO metadata (sitemap.xml, robots.txt, canonical
# and Open Graph/Twitter image links). Must include the protocol, no
# trailing slash. Use http://localhost:3000 in development and
# https://sksupplement.shop in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" opens the shop. Unset or anything else keeps it closed: prices show
# "به زودی" and the cart, checkout and payment APIs refuse orders. Inlined at
# build time, so redeploy after changing it in Vercel.
NEXT_PUBLIC_SALES_OPEN=true

# Resend (https://resend.com) for transactional email such as password reset
# links. Leave both empty in development: emails are then printed to the
# terminal running `npm run dev` instead of being sent. EMAIL_FROM must use a
# domain verified in Resend, e.g. "SK Supplement <no-reply@sksupplement.shop>".
RESEND_API_KEY=
EMAIL_FROM=
